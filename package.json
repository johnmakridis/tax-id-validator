{
  "name": "@johnmakridis/tax-id-validator",
  "version": "1.1.0",
  "description": "Validate the format of VAT, GST, TIN, EIN and other tax identification numbers for 167+ countries, with optional live EU VAT lookup via VIES",
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "types": "lib/models/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "tslint -p tsconfig.json",
    "test": "jest",
    "prebuild": "shx rm -rf lib",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "preversion": "npm run lint && npm test",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "author": {
    "name": "John Makridis",
    "url": "https://johnmakridis.github.io",
    "github": "https://github.com/johnmakridis"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnmakridis/tax-id-validator"
  },
  "homepage": "https://johnmakridis.github.io",
  "license": "MIT",
  "keywords": [
    "Tax ID",
    "VAT",
    "GST",
    "TIN",
    "EIN",
    "VIES",
    "Validator",
    "Validation",
    "RegExp",
    "TypeScript"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.14",
    "jest": "^30.4.2",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib/**/*"
  ]
}